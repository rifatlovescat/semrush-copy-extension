{
  "manifest_version": 3,
  "name": "Semrush Quick Copy",
  "version": "1.2.1",
  "description": "Instant 1-click copy & export for Semrush Keyword Magic Tool into Google Sheets with KGR (Keyword Golden Ratio) auto-calculation.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Semrush Quick Copy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "*://*.semrush.com/*",
    "*://*.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.semrush.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/search*"
      ],
      "js": [
        "google_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
