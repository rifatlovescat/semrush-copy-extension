{
  "manifest_version": 3,
  "name": "Semrush Quick Copy",
  "version": "1.3.1",
  "description": "Instant 1-click copy & export for Semrush Keyword Magic Tool into Google Sheets with KGR (Keyword Golden Ratio) auto-calculation.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Semrush Quick Copy",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "*://*.semrush.com/*",
    "*://*.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.semrush.com/*"
      ],
      "js": [
        "src/shared/colors.js",
        "src/shared/storage.js",
        "src/shared/formatters.js",
        "src/content/scraper.js",
        "src/content/kgr-runner.js",
        "src/content/widget-ui.js",
        "src/content/index.js"
      ],
      "css": [
        "src/content/styles/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.google.com/search*"
      ],
      "js": [
        "src/google/grabber.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
